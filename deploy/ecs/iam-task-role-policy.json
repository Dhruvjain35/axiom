{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeExactlyTheTwoModelsAxiomUses",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:REGION::foundation-model/amazon.titan-embed-text-v2:0",
        "arn:aws:bedrock:REGION::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0"
      ]
    },
    {
      "Sid": "WriteOwnLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/axiom/api:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/axiom/worker:*"
      ]
    },
    {
      "Sid": "EcsExecSsmMessagingChannel",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcsExecSessionTranscript",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    }
  ]
}
