{
  "family": "axiom-worker",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/axiom-ecs-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/axiom-ecs-task",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/axiom:IMAGE_TAG",
      "essential": true,
      "command": ["python", "-m", "axiom.worker"],
      "environment": [
        { "name": "AXIOM_OFFLINE", "value": "0" },
        { "name": "AWS_REGION", "value": "REGION" },
        { "name": "AXIOM_EMBED_MODEL", "value": "amazon.titan-embed-text-v2:0" },
        { "name": "AXIOM_LLM_MODEL", "value": "anthropic.claude-sonnet-4-5-20250929-v1:0" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/axiom/prod/DATABASE_URL"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"from axiom import db; db.tx(lambda c: c.execute('SELECT 1'), readonly=True)\""
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 20
      },
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/axiom/worker",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
