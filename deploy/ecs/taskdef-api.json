{
  "family": "axiom-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/axiom-ecs-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/axiom-ecs-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/axiom:IMAGE_TAG",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "AXIOM_OFFLINE", "value": "0" },
        { "name": "AWS_REGION", "value": "REGION" },
        { "name": "AXIOM_EMBED_MODEL", "value": "amazon.titan-embed-text-v2:0" },
        { "name": "AXIOM_LLM_MODEL", "value": "anthropic.claude-sonnet-4-5-20250929-v1:0" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/axiom/prod/DATABASE_URL"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4).read()\""
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/axiom/api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
